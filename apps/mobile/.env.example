# OpsWatch mobile — copy to `.env` and edit. `.env` is git-ignored.
#
# Nothing here is a secret, and nothing here may become one. Every value in this file is compiled into the app
# binary, which anyone who installs the app can read. The mobile app never holds an AWS, GitHub, Cloudflare or AI
# provider credential: those stay on the OpsWatch server, which is the only thing this app talks to.
#
# All of these are optional. With none of them set, the app builds with placeholder store identifiers and asks for a
# server URL on first launch — which is exactly what you want for local development and for the demo.

# Pre-fills the server URL on the Connect screen, so you do not retype it on every fresh install.
# Anything prefixed EXPO_PUBLIC_ is readable inside the app bundle by design.
#   Android emulator, server on your machine: http://10.0.2.2:4010
#   iOS simulator, server on your machine:    http://localhost:4010
#   Phone on the same network:                http://<your computer's LAN IP>:4010
# Plain http:// is only accepted by a development build, for a private address, after you switch on
# "Allow plain HTTP" on the Connect screen. A release build requires https://.
# EXPO_PUBLIC_DEFAULT_SERVER_URL=http://10.0.2.2:4010

# Store identifiers. Without them the app builds as com.example.opswatch, which both stores reject — deliberately,
# so a placeholder cannot be published by accident. The `production` EAS profile refuses to build until they are set.
# These can never be changed after a first release, so choose them once: docs/mobile/app-identity.md.
# OPSWATCH_IOS_BUNDLE_ID=com.yourcompany.opswatch
# OPSWATCH_ANDROID_PACKAGE=com.yourcompany.opswatch

# Universal links and Android App Links. Without it, only opswatch:// deep links work.
# The domain must serve the association files described in docs/mobile/app-identity.md.
# OPSWATCH_ASSOCIATED_DOMAIN=ops.yourcompany.com

# Expo account and EAS project, for cloud builds only. `eas init` writes these for you.
# EXPO_OWNER=your-expo-account
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Build numbers. EAS owns these for cloud builds (eas.json sets appVersionSource: "remote"), so set them only for a
# local native build you intend to upload by hand.
# OPSWATCH_IOS_BUILD_NUMBER=1
# OPSWATCH_ANDROID_VERSION_CODE=1
