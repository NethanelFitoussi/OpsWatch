{
  "name": "@opswatch/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:demo": "EXPO_PUBLIC_DEFAULT_SERVER_URL=http://localhost:4010 expo start",
    "mock-server": "tsx dev/mock-server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "export:web": "expo export --platform web --output-dir dist-web",
    "e2e:web": "playwright test --config e2e/web/playwright.config.ts",
    "doctor": "expo-doctor",
    "check": "npm run lint && npm run typecheck && npm test",
    "store:export": "EXPO_PUBLIC_SCREENSHOT_AT=1773740520000 expo export --clear --platform web --output-dir dist-web",
    "store:web": "playwright test --config e2e/store/playwright.config.ts",
    "store:capture": "npm run store:export && npm run store:web",
    "store:android": "bash e2e/store/capture-android.sh",
    "store:validate": "tsx e2e/store/validate.ts",
    "store:capture:fr": "npm run store:export && OPSWATCH_STORE_LOCALE=fr playwright test --config e2e/store/playwright.config.ts",
    "a11y:scan": "bash dev/device/a11y-scan.sh"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  }
}
