{
  "name": "opswatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "lint:template": "tsx scripts/write-sample-template.ts && docker run --rm -v \"$PWD/tmp:/data\" python:3.13-slim sh -c \"pip install -q --root-user-action=ignore --disable-pip-version-check cfn-lint==1.56.3 && cfn-lint /data/opswatch-sample.yaml\"",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "verify:persistence": "bash scripts/verify-persistence.sh",
    "audit:nav": "playwright test --config tests/audit/playwright.config.ts nav-walk",
    "roadmap:check": "tsx scripts/roadmap-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1134.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1134.0",
    "@aws-sdk/client-ecs": "^3.1134.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1134.0",
    "@aws-sdk/client-lambda": "^3.1139.0",
    "@aws-sdk/client-pi": "^3.1134.0",
    "@aws-sdk/client-rds": "^3.1134.0",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/client-sqs": "^3.1139.0",
    "@aws-sdk/client-sts": "^3.1134.0",
    "@aws-sdk/credential-providers": "^3.1134.0",
    "@node-rs/argon2": "^2.2.1",
    "@smithy/types": "^4.18.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "openid-client": "6.8.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.1139.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
